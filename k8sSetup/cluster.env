# Cluster settings shared by every script. Edit this once, then copy the folder to every node
# (00-copy-to-nodes.sh does that for you).

# Kubernetes minor version to install from pkgs.k8s.io. All nodes get the same version.
K8S_VERSION=v1.36

# Name used for the kubectl context/cluster/user on your workstation (keeps it apart from docker-desktop).
CLUSTER_NAME=own-cluster

# --- Machines -------------------------------------------------------------------------------
# IP of the control-plane node. kube-apiserver listens here on 6443; every node and kubectl connect to it.
CONTROL_PLANE_IP=192.168.1.10
# Optional DNS name / virtual IP for the API server (needed later if you add more control planes).
# Leave empty to use CONTROL_PLANE_IP.
CONTROL_PLANE_ENDPOINT=
# Space-separated worker IPs (empty = single-node cluster).
WORKER_IPS="192.168.1.11 192.168.1.12"
# SSH user (with sudo) on every node, used by the scripts you run from your workstation.
SSH_USER=ubuntu

# --- Networking ------------------------------------------------------------------------------
# Pod IP range. Flannel gives each node a /24 out of it. Must not overlap your LAN.
POD_CIDR=10.244.0.0/16
# Service (ClusterIP) range. Virtual IPs only, never on the wire. Must not overlap your LAN.
SERVICE_CIDR=10.96.0.0/12
# Flannel release: "latest" or a tag such as v0.27.0.
FLANNEL_VERSION=latest

# --- Load balancer (MetalLB) -----------------------------------------------------------------
METALLB_VERSION=v0.15.2
# Free IPs in the SAME subnet as the nodes and OUTSIDE your router's DHCP range.
# Services of type LoadBalancer get their external IP from here.
METALLB_IP_RANGE=192.168.1.240-192.168.1.250

# --- App -------------------------------------------------------------------------------------
APP_NAMESPACE=nomanualcode
